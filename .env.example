# Google Places API (New) key. Enable "Places API (New)" in Google Cloud and add billing.
GOOGLE_PLACES_API_KEY=

# Password for the web app. Set this before you deploy anywhere public.
APP_PASSWORD=change-me
# Random string used to sign the login cookie.
SESSION_SECRET=change-me-too

# Daily automatic lead search, server time in HH:MM (24h). Leave empty to disable.
AUTO_DISCOVER_TIME=08:30
# Secret for triggering discovery from an external cron service (optional).
CRON_SECRET=

# Where the SQLite file lives. Use a persistent disk in production.
DB_PATH=data/outreach.db
